# %% [markdown]
# # stdf — 分析ワークスペース
# `cp query.py.example query.py` して使う。Shift+Enter でセル実行。
#
# 定番分析は dbt マートに済んでいる — まず `SELECT * FROM <マート名>`:
#   lot_yield_summary / fail_ranking / cpk_stats / bin_pareto / bin_fail_tests
# 生テーブル(*_final)も同じセッションから引ける。
# **2回使った SQL は dbt/analyses/ に昇格させること(workspace/README.md)。**

# %% Setup
from stdf_platform.analysis import AnalysisSession

_session = AnalysisSession()          # config.yaml の data_dir を解決
con = _session.conn
q = _session.q                        # q("SELECT ...") → DataFrame

def to_csv(sql: str, output="output.csv"):
    n = con.execute(
        f"COPY ({sql.rstrip('; ')}) TO '{output}' (HEADER, DELIMITER ',')"
    ).fetchone()[0]
    print(f"Exported {n:,} rows → {output}")

print("views:", ", ".join(_session.registered))

# %% ロット一覧(歩留まり付き)
q("SELECT * FROM lot_yield_summary ORDER BY start_time DESC")

# %% Fail ランキング
LOT_ID = "LOT001"
q("SELECT * FROM fail_ranking WHERE lot_id = ? ORDER BY fail_pct DESC", [LOT_ID])

# %% Cpk ワースト
q("SELECT * FROM cpk_stats WHERE lot_id = ? ORDER BY cpk ASC LIMIT 20", [LOT_ID])

# %% ビン分布
q("SELECT * FROM bin_pareto WHERE lot_id = ? ORDER BY count DESC", [LOT_ID])

# %% 自由探索(書き捨てはここから下に)
q("SELECT 1 AS hello")
